# Leave unset to use local SQLite (backend/data/rag.db).
# Postgres example:
# DATABASE_URL=postgresql://rag:rag@localhost:5432/rag
DATABASE_URL=

# Optional: put the SQLite file somewhere else (ignored when DATABASE_URL is set).
# SQLITE_PATH=/tmp/rag-dev.db

# Optional. When set, /api/ask uses OpenAI chat with retrieved context.
# Without it, the app stays in extractive mode (no paid key required).
OPENAI_API_KEY=

# Optional model override for LLM mode.
OPENAI_MODEL=gpt-4o-mini

# Set to 1 to embed with sentence-transformers (all-MiniLM-L6-v2).
# Default is the offline 256-d n-gram hasher — first run stays fast.
SENTENCE_TRANSFORMERS=0
